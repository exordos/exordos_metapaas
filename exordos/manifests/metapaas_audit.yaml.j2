name: "metapaas_audit"
description: "Optional Audit delivery for MetaPaaS"
schema_version: 1
version: "{{ version }}"
api_version: "v1"

requirements:
  metapaas:
    from_version: "0.0.0"
  audit:
    from_version: "0.0.0"
  core:
    from_version: "0.0.0"

imports:
  metapaas_project:
    element: "$metapaas"
    kind: "resource"
    link: "$core.iam.projects.$metapaas_project"
  metapaas_cp:
    element: "$metapaas"
    kind: "resource"
    link: "$core.compute.nodes.$metapaas_cp"
  audit_events_create:
    element: "$audit"
    kind: "resource"
    link: "$core.iam.permissions.$events_create"
  var_iam_default_client_uuid:
    element: "$core"
    kind: "resource"
    link: "$core.vs.variables.$iam_default_client_uuid"

resources:

  $core.iam.users:
    metapaas_audit_user:
      username: metapaas_audit
      email: "noreply+metapaas-audit@exordos.com"
      type: service
      password: "unused-by-a-service-account"

  $core.iam.roles:
    metapaas_audit:
      name: metapaas_audit
      description: "MetaPaaS audit event delivery"

  $core.iam.permissionbinding:
    metapaas_audit_events_create_binding:
      role: $core.iam.roles.$metapaas_audit:uuid
      permission: $metapaas_audit.imports.$audit_events_create:uuid
      project_id: $metapaas_audit.imports.$metapaas_project:uuid

  $core.iam.rolebinding:
    metapaas_audit_role_binding:
      role: $core.iam.roles.$metapaas_audit:uuid
      user: $core.iam.users.$metapaas_audit_user:uuid
      project: $metapaas_audit.imports.$metapaas_project:uuid

  $core.iam.tokens:
    metapaas_audit_token:
      user: $core.iam.users.$metapaas_audit_user:uuid
      iam_client: $metapaas_audit.imports.$var_iam_default_client_uuid:value
      issuer: f"http://core.local.genesis-core.tech/api/core/v1/iam/clients/{$metapaas_audit.imports.$var_iam_default_client_uuid:value}"
      scope: f"project:{$metapaas_audit.imports.$metapaas_project:uuid}"
      auto_renew: true
      expiration_delta: 604800

  $core.config.configs:
    metapaas_audit_config:
      project_id: "12345678-c625-4fee-81d5-f691897b8142"
      path: /etc/exordos_metapaas/exordos_metapaas.d/audit.conf
      mode: "0600"
      target:
        kind: node
        node: $metapaas_audit.imports.$metapaas_cp:uuid
      on_change:
        kind: shell
        command: systemctl try-restart exordos-metapaas-user-api
      body:
        kind: text
        content: |
          f"
          [audit_delivery]
          enabled = true
          endpoint = {{ audit_endpoint | default('http://audit.local.genesis-core.tech:8080/') }}
          auth_token = {$core.iam.tokens.$metapaas_audit_token:access_token}
          "
