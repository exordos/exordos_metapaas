[Unit]
Description=Exordos MetaPaaS Orch API
After=network-online.target postgresql.service

[Service]
TimeoutStartSec=130
TimeoutStopSec=35
RuntimeDirectory=exordos-metapaas-orch-api
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=5s
KillMode=mixed
KillSignal=SIGTERM
ExecStartPre=/bin/sleep 2
ExecStart=exordos-metapaas-orch-api --config-file /etc/exordos_metapaas/exordos_metapaas.conf --config-dir /etc/exordos_metapaas/exordos_metapaas.d

ExecReload=/opt/exordos_metapaas/.venv/bin/python -m gcl_looper.services.reload_control
RestartForceExitStatus=SIGHUP

[Install]
WantedBy=multi-user.target
