[Unit]
Description=Exordos MetaPaaS Core Agent (db-back: CP entities -> universal-agent resources)
After=network-online.target postgresql.service

[Service]
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5
ExecStart=exordos-universal-agent-db-back --config-file /etc/exordos_metapaas/core_agent.conf --config-dir /etc/exordos_metapaas/exordos_metapaas.d

[Install]
WantedBy=multi-user.target
