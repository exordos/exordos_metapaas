[Unit]
Description=Exordos MetaPaaS Status API
After=network-online.target postgresql.service

[Service]
TimeoutStopSec=35
Restart=on-failure
RestartSec=5s
KillMode=mixed
KillSignal=SIGTERM
ExecStartPre=/bin/sleep 2
ExecStart=exordos-metapaas-status-api --config-file /etc/exordos_metapaas/exordos_metapaas.conf --config-dir /etc/exordos_metapaas/exordos_metapaas.d

ExecReload=/bin/kill -HUP $MAINPID
RestartForceExitStatus=SIGHUP

[Install]
WantedBy=multi-user.target
